# systemd --user unit for jacket. Install/enable with packaging/install.sh,
# or by hand:
#   systemctl --user enable --now jacket.service
#
# It binds to graphical-session.target, so it starts when your Wayland session
# comes up and stops when it goes away. The compositor is expected to reach the
# systemd user session (most do; if yours doesn't, start run.sh from your config
# autostart instead).
[Unit]
Description=jacket (Wayland bar / panels / notifications / launcher)
Documentation=https://github.com/jaseci-labs/jaseci
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# %h = the user's home; jacket must be on PATH (see packaging/install.sh).
ExecStart=jacket run
Restart=on-failure
RestartSec=2
# Bring the shell down cleanly on logout.
KillMode=mixed
Slice=session.slice

[Install]
WantedBy=graphical-session.target
